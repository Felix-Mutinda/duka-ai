DUKA_MODE=guarded
DUKA_LLM_MODE=auto
DUKA_LLM_PROVIDER=openai_compatible
DUKA_LLM_MODEL=gpt-4o-mini
DUKA_LLM_BASE_URL=https://api.openai.com/v1
DUKA_MAX_RESPONSE_CHARS=300

# Live composer key.
# The key is intentionally not prefixed with DUKA_ because many providers
# already use OPENAI_API_KEY by convention.
# OPENAI_API_KEY=your-key